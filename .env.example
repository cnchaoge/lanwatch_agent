# 服务端环境变量配置示例
# 复制此文件为 .env 并填入实际值

# Server酱 Webhook（告警推送）
SCKEY=

# 管理后台密码
ADMIN_PASSWORD=admin

# CORS 允许的来源（逗号分隔，留空则同源）
# 示例：https://example.com,https://app.example.com
CORS_ORIGINS=

# 数据库路径
DB_PATH=monitor.db

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ── lanwatch-diagnostic 视图鉴权 ──
# GET /api/diag_reports/{agent_id} 的访问令牌
# CLI 端使用同一个 token；留空则该端点拒绝所有请求（fail-closed）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
DIAGNOSTIC_VIEW_TOKEN=

# 数据保留天数（到期自动清理）
RETENTION_PROBE_DAYS=5    # 探测日志保留 5 天
RETENTION_SNMP_DAYS=5     # SNMP 指标保留 5 天
RETENTION_ALERT_DAYS=30   # 告警日志保留 30 天
RETENTION_DIAG_DAYS=30    # 诊断报告保留 30 天

# ── 对外展示信息（脱敏配置）──
# 留空表示不显示该字段；不要在仓库中硬编码手机号/微信/IP
CONTACT_PHONE=             # 示例：185-3172-9777（仅部署时设置）
CONTACT_HOURS=             # 示例：早 9:00 - 晚 6:00
WECHAT_QR_URL=             # 微信二维码公网 URL（留空则营销页不显示）
OFFICIAL_WEBSITE=          # 默认 https://github.com/cnchaoge/lanwatch_agent
SERVER_PUBLIC_URL=         # 营销页/FAQ 中展示的服务端地址（留空则用占位符 your-server-ip:8000）
